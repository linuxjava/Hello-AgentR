# this config is to ignore lombok code in jacoco
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true

# fix @Data callSuper=false
# 所有 @Data、@EqualsAndHashCode 默认不使用父类字段参与 equals，同时不再弹出警告。
lombok.equalsAndHashCode.callSuper = skip

# lombok.config
# 把 @Qualifier 注解自动复制到 Lombok 生成的构造函数参数上，不加这条配置时：
# Lombok 生成构造方法参数不带@Qualifier，Spring 无法识别区分 Bean，会报错找不到候选 Bean。
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
